@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Transitive PUBLIC dependencies that consumers linking against
# unitree_kinematics::unitree_kinematics also need resolvable.
# DQ Robotics and its CoppeliaSim ZMQ interface are intentionally NOT re-found
# here: they have no CMake package config of their own (see the find_library()
# note in CMakeLists.txt), so their absolute paths are already baked directly
# into the exported INTERFACE_LINK_LIBRARIES / INTERFACE_INCLUDE_DIRECTORIES by
# install(EXPORT ...) -- nothing further to resolve.
find_dependency(Eigen3 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/unitree_kinematicsTargets.cmake")

check_required_components(unitree_kinematics)
